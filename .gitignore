# ==========================================
# Python
# ==========================================

__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pyc

.venv/
venv/
env/

.env
.env.*
# Template files are meant to be committed — .env.* above would otherwise
# silently swallow them too (found during M0 verification: backend/.env.example
# had never actually been tracked, since the repo's first commit).
!.env.example
!**/.env.example

.pytest_cache/
.mypy_cache/

# Uploads
backend/app/uploads/

# Rendered report PDF cache (M2A P6) — regenerable artifacts, never source
backend/var/

# ==========================================
# Secrets — never commit credentials
# ==========================================

# GCP/Earth Engine service-account keys, wherever they end up. The real fix
# is keeping the key file outside the repo entirely (see .env's
# GEE_SERVICE_ACCOUNT_JSON_PATH) — this is a backstop, not the primary control.
*service-account*.json
terrarisk-platform-*.json
*.key

# ==========================================
# Node.js / Next.js
# ==========================================

node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

coverage/

.next/
out/

build/
dist/

.DS_Store
*.pem

# ==========================================
# Docker / nginx — never commit real TLS material
# ==========================================
docker/nginx/certs/*
!docker/nginx/certs/.gitkeep
*.crt
*.key

npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

.vercel

*.tsbuildinfo
next-env.d.ts

# ==========================================
# VS Code
# ==========================================

.vscode/

# ==========================================
# OS
# ==========================================

Thumbs.db
# ==========================================
# Internal strategy documents
# ==========================================
# Business/market analysis and partner-facing proposals. This repository
# is public for portfolio purposes, and these are neither code nor
# anything a reader of it should see — they name third parties and
# discuss commercial positioning. Listed explicitly so a future
# `git add -A` cannot sweep them in.

TerraRisk-Report.pdf
docs/Nuksan_Praman_Validation.md
docs/Problem_Discovery_2026.md
docs/TerraRisk_Dhoran_Punarvichar_2026.md
docs/WELL_Labs_Digital_Vertical_Proposal.md
docs/WELL_Labs_Internship_Project_Plan.md
docs/FSID_Incubation_Readiness_2026.md
docs/Bank_Target_Research_2026.md

# ==========================================
# ML training artifacts
# ==========================================
# Feature CSVs are regenerable from labels + Earth Engine, and label
# GeoJSONs may contain field boundaries tied to identifiable people.
.venv-train/
ml/*.csv
ml/labels.geojson

# Field labels and extracted features: real coordinates of real farms,
# collected in person. Kept out of the public repository until there is a
# licence for them; the template and the tools are versioned, the data is not.
ml/labels.geojson
ml/features.csv
ml/incoming/*.txt
!ml/incoming/TEMPLATE.txt
ml/sugarcane_model.txt
