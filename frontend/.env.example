# Backend API base URL. NEXT_PUBLIC_ prefix is required for Next.js to
# expose it to the browser bundle — this is a base URL, not a secret.
# Matches backend/.env.example's default uvicorn port. NEXT_PUBLIC_ vars are
# inlined at build time, not read at container runtime — see
# docs/Deployment_Guide.md for how the production Docker build sets this.
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Optional — map basemap tile URL (src/config.ts). Defaults to Esri World
# Imagery if unset, which is free for dev/demo use only; a commercial
# deployment should review Esri's licensing terms before launch (see
# docs/DECISIONS.md) and may need to point this at a licensed provider.
# NEXT_PUBLIC_MAP_TILE_URL=https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}
