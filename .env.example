# Environment for the PRODUCTION Docker Compose stack
# (docker/docker-compose.prod.yml). Copy to `.env` in the repo root and
# fill in real values — never commit the real `.env`.
#
#   cp .env.example .env
#   docker compose --env-file .env -f docker/docker-compose.prod.yml up -d --build
#
# This file is unrelated to backend/.env.example and frontend/.env.example,
# which configure the *local, non-Docker* dev servers (`uvicorn`/`npm run
# dev`) started directly on your machine — see docs/Getting_Started.md for
# when to use which. See docs/Deployment_Guide.md for the full deployment
# walkthrough (SSL, backups, updating).

# ------------------------------------------------------------------
# PostgreSQL / PostGIS
# ------------------------------------------------------------------
# Generate real credentials — never reuse these example values:
#   python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_USER=terrarisk
POSTGRES_PASSWORD=replace-with-a-generated-password
POSTGRES_DB=terrarisk
# No DATABASE_URL here — docker-compose.prod.yml builds it automatically
# from the three POSTGRES_* values above, pointed at the postgres service
# by its Compose service name. One source of truth, nothing to keep in sync.

# ------------------------------------------------------------------
# Backend — auth
# ------------------------------------------------------------------
# Bearer-token signing secret. Generate your own — never reuse this example
# value, and never reuse a value that has ever been committed anywhere:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# backend/app/core/config.py refuses to start in production with this
# placeholder or with any secret under 32 characters (see docs/DECISIONS.md).
JWT_SECRET=replace-with-a-generated-secret
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=720

# ------------------------------------------------------------------
# Backend — Google Earth Engine (see docs/DECISIONS.md for the
# project/service-account setup walkthrough)
# ------------------------------------------------------------------
GEE_PROJECT_ID=terrarisk-platform
# Path on the HOST machine to the service-account key file — Compose bind-
# mounts it read-only into the backend container at a fixed internal path
# (docker-compose.prod.yml); the app itself always sees the fixed path.
# Keep the real key file outside the repo entirely.
GEE_SERVICE_ACCOUNT_JSON_HOST_PATH=/absolute/path/to/terrarisk-gee-service-account.json

# ------------------------------------------------------------------
# Backend — application
# ------------------------------------------------------------------
APP_NAME=Kshetra Credit Intelligence API
APP_VERSION=0.1.0
# Enables the startup production-safety checks in config.py (weak/placeholder
# JWT_SECRET, DEBUG=True) — always "production" for a real deployment.
ENVIRONMENT=production
# Verbose SQL logging (every statement + bound parameter value). Bound
# parameters can carry PII once real farmer/loan data is loaded — must stay
# False in any shared/production environment.
DEBUG=False

# ------------------------------------------------------------------
# Frontend / CORS — the single public origin this deployment is served on
# ------------------------------------------------------------------
# Same URL end users hit through nginx, e.g. https://terrarisk.yourbank.example
# Used by the backend's CORS policy (defense-in-depth for any caller that
# bypasses nginx) — same-origin browser traffic through nginx never
# actually needs CORS, since nginx proxies /api/ and / on one origin.
FRONTEND_ORIGIN=https://terrarisk.yourbank.example
# Leave blank (relative, same-origin via nginx) unless the frontend is
# deployed without nginx in front of it — see docker/docker-compose.prod.yml.
NEXT_PUBLIC_API_BASE_URL=

# ------------------------------------------------------------------
# nginx TLS (see docs/Deployment_Guide.md §4)
# ------------------------------------------------------------------
# nginx.conf serves plain HTTP and needs no certificate. nginx.https.conf
# serves https://kshetra.in and refuses to start until its certificate has
# been issued — switch only after §4's certbot step succeeds.
# nginx.https-ip.conf serves https://174.138.122.238 — the interim until the
# domain exists, with a six-day IP certificate (same section).
NGINX_CONF_FILE=nginx.conf
